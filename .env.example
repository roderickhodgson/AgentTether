# ── Payment plane (x402) ─────────────────────────────────────────────
# Neon Postgres connection string (Phase 1.2)
DATABASE_URL=

FACILITATOR_URL=https://x402.org/facilitator
HEDERA_FACILITATOR_URL=https://api.testnet.blocky402.com
NETWORK=eip155:84532
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Demo agent wallet (public address only — never commit private keys)
AGENT_WALLET=

PAY_TO_ADDRESS=
HEDERA_PAY_TO=                # receiver on hedera:testnet (0.0.x or 0x — 0x resolved via the mirror)
HEDERA_PAYER_ACCOUNT_ID=       # demo client's hedera account (0.0.x) paying the hedera rail

# ── Data plane (Substreams — independent of NETWORK) ─────────────────
DATA_CHAIN=ethereum-mainnet
SUBSTREAMS_ENDPOINT=https://mainnet.eth.streamingfast.io:443
SUBSTREAMS_API_KEY=

# ── Oneshot pull endpoint (3.4) ───────────────────────────────────────
ONESHOT_CONTRACTS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48  # capture allowlist (comma-sep)
ONESHOT_LOOKBACK_BLOCKS_MAX=300                               # max blocks the endpoint will look back
ONESHOT_RETENTION_HOURS=2                                     # capture table prune window
ONESHOT_PRICE_BASE_ATOMIC=500                                 # USDC atomic units (6 decimals) per lookup
ONESHOT_PRICE_HEDERA_TINYBAR=10000                            # tinybars (8 decimals) per lookup

PORT=8080

SUBSTREAMS_SPKG=vendor/erc20Transfers-v0.1.4.spkg
SUBSTREAMS_MODULE=map_transfers

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info            # debug = per-match/per-block detail
LOG_PRETTY=1              # human-readable terminal lines (omit for JSON)
