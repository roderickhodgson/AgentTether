generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntentStatus {
  PENDING_PAYMENT
  MONITORING
  SETTLING
  SETTLED
  TIMEOUT
  SETTLE_FAILED
}

model Intent {
  id                 String       @id @default(uuid())
  agentWallet        String       @map("agent_wallet")
  targetContract     String       @map("target_contract")
  ttlTimestamp       DateTime     @map("ttl_timestamp")
  maxLimitAtomic     String       @map("max_limit_atomic")
  perBlockRateAtomic String       @map("per_block_rate_atomic")
  budgetBlocks       Int          @map("budget_blocks")
  startBlockNum      Int?         @map("start_block_num")
  eventsMatched      Int          @default(0) @map("events_matched")
  paymentNonce       String?      @unique @map("payment_nonce")
  paymentPayload     Json?        @map("payment_payload")
  eventCondition     Json         @map("event_condition")
  status             IntentStatus @default(PENDING_PAYMENT)
  webhookUrl         String?      @map("webhook_url")
  matchedEvents      Json?        @map("matched_events")
  settlementTxHash   String?      @map("settlement_tx_hash")
  settledAmountAtomic String?     @map("settled_amount_atomic")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("intents")
}

model SubstreamsCursor {
  id        String   @id @default("singleton")
  cursor    String
  blockNum  Int      @map("block_num")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("substreams_cursor")
}

// Rolling capture of transfers for the oneshot lookback endpoint — filtered to the
// allowlisted contracts at capture time (ONESHOT_CONTRACTS), pruned past the retention
// window by the sweep. Written in the same per-block transaction as metering + the
// cursor, so the cursor never advances past uncaptured blocks.
model ProcessedTransfer {
  id             String   @id @default(uuid())
  chain          String
  blockNum       Int      @map("block_num")
  blockTimestamp DateTime @map("block_timestamp")
  txHash         String   @map("tx_hash")
  logIndex       Int      @map("log_index")
  contract       String
  from           String
  to             String
  amount         BigInt
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([blockNum, txHash, logIndex])
  @@index([contract, blockNum])
  @@index([createdAt])
  @@map("processed_transfers")
}
